# Use Python 3.11 base image
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    wget \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy the ml-mdm project
COPY ml-mdm/ /app/ml-mdm/

# Create a simple wrapper script that bypasses MLX
RUN echo '#!/bin/bash\n\
export PYTHONPATH=/app/ml-mdm/ml-mdm-matryoshka\n\
export CUDA_VISIBLE_DEVICES=""\n\
export PYTORCH_ENABLE_MPS_FALLBACK=1\n\
cd /app/ml-mdm/ml-mdm-matryoshka\n\
python -c "\n\
import sys\n\
import os\n\
sys.path.insert(0, \"/app/ml-mdm/ml-mdm-matryoshka\")\n\
\n\
# Mock MLX modules to avoid import errors\n\
class MockMLX:\n\
    class data:\n\
        class core:\n\
            CharTrie = None\n\
\n\
sys.modules[\"mlx\"] = MockMLX()\n\
sys.modules[\"mlx.data\"] = MockMLX.data()\n\
sys.modules[\"mlx.data.core\"] = MockMLX.data.core()\n\
\n\
# Now run the actual application\n\
from ml_mdm.clis.generate_sample import main\n\
import argparse\n\
\n\
parser = argparse.ArgumentParser()\n\
parser.add_argument(\"--port\", default=8080, type=int)\n\
parser.add_argument(\"--config_path\", default=\"configs/models/cc12m_64x64.yaml\")\n\
parser.add_argument(\"--model-file\", default=\"vis_model_64x64.pth\")\n\
args = parser.parse_args()\n\
\n\
main(args)\n\
"' > /app/run.sh && chmod +x /app/run.sh

# Set environment variables
ENV PYTHONPATH=/app/ml-mdm/ml-mdm-matryoshka
ENV CUDA_VISIBLE_DEVICES=""
ENV PYTORCH_ENABLE_MPS_FALLBACK=1

# Create directories for models and outputs
RUN mkdir -p /app/models /app/outputs

# Expose port
EXPOSE 8080

# Default command
CMD ["/app/run.sh"]
